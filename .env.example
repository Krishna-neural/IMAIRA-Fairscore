# ==============================================================================
# IMAIRA FairScore Environment Configuration Template
# Copy this file to '.env' to configure your environment.
# ==============================================================================

# Server Network Configuration
FAIRSCORE_HOST=0.0.0.0
FAIRSCORE_PORT=8002

# Google Gemini LLM API Configuration (Optional: Deterministic offline judge used if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ASR GPU Worker Configuration (Optional: Web Speech API / Bridge used if omitted)
ASR_WORKER_URL=http://localhost:8001
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL=large-v3

# Platform Security & Authentication
IMAIRA_API_KEY=
